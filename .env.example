# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Project Configuration
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=nl
TARGET_AGE_RANGE=14-16

# Gutenberg Book ID
GUTENBERG_BOOK_ID=674

# Additional Gutenberg editions for cross-checking (comma-separated)
CROSS_CHECK_EDITIONS=14033,14034,14035,44315

# Translation Settings
TRANSLATION_MODEL=claude-sonnet-4-5-20250929
MAX_CHUNK_SIZE=2000
TEMPERATURE=0.3

# Wikipedia Settings
WIKIPEDIA_LANGUAGE=nl
MAX_WIKIPEDIA_CONCEPTS=50

# Output Settings
OUTPUT_FORMAT=epub
EPUB_TITLE=Plutarchus - Levens van Beroemde Grieken en Romeinen
EPUB_AUTHOR=Plutarchus
EPUB_LANGUAGE=nl
